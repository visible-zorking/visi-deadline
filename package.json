{
  "name": "VisiZork-Deadline",
  "version": "1.0",
  "description": "An interactive fiction visualizer",
  "author": "Andrew Plotkin <erkyrath@eblong.com>",
  "license": "MIT",
  "scripts": {
    "buildall": "npm run buildjs && npm run builddata",
    "buildjs": "npm run minify && npm run buildts",
    "buildts": "npx tsc && npx rollup -c",
    "minify": "./minify gamedat.js && ./minify lib.js && ./minify glkio.js && ./minify ifvms.js && ./minify gnusto.js && ./minify parchment.js",
    "builddata": "npm run recreate-gamedata && npm run rearrange-tables && npm run recolor-source && npm run regenerate-commentary && npm run reparse-map",
    "recreate-gamedata": "python3 visiterp/pyana/parse.py --game deadline-r27-s831005 -z gamesrc/deadline.zil --obj --dict --grammar --txd --gamedat",
    "rearrange-tables": "python3 visiterp/pyana/parse.py --game deadline-r27-s831005 -z gamesrc/deadline.zil --zcode gamedat/deadline-r27-s831005.z3 --gamedat",
    "recolor-source": "python3 visiterp/pyana/parse.py --game deadline-r27-s831005 -z gamesrc/deadline.zil --src",
    "regenerate-commentary": "python3 visiterp/pyana/comgen.py gamedat/commentary",
    "reparse-map": "python3 visiterp/pyana/mapparse.py gamedat/base-map.svg"
  },
  "type": "module",
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@types/node": "22.19.15",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "rollup": "4.59.0",
    "terser": "5.46.1",
    "typescript": "5.9.3"
  }
}
